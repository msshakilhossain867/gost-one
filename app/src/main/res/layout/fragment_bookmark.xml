<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:orientation="vertical"
    tools:context=".fragments.BookmarkFragment">

    <!-- Top Header & Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_10sdp">

        <!-- Search Input -->
        <EditText
            android:id="@+id/edSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/baseline_search_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_secondary"
            android:fontFamily="@font/kalpurush"
            android:hint="বুকমার্ক করা গল্প খুঁজুন..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="@dimen/_13ssp" />

        <!-- Segmented Tab Switcher (Bookmark vs Favorite) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">

            <!-- Bookmark Tab Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tabBookmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/accent_horror"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/ivTabBookmarkIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_bookmark_24"
                        app:tint="@color/accent_horror" />

                    <TextView
                        android:id="@+id/tvTabBookmarkText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/kalpurush"
                        android:text="বুকমার্ক (০)"
                        android:textColor="@color/accent_horror"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Favorite Tab Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tabFavorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/card_surface_secondary"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/ivTabFavoriteIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_favorite_24"
                        app:tint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/tvTabFavoriteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/kalpurush"
                        android:text="ফেভারিট (০)"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/txtBookmarkEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/baseline_bookmark_border_24"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/kalpurush"
            android:text="কোনো বুকমার্ক পাওয়া যায়নি"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/kalpurush"
            android:gravity="center"
            android:text="পছন্দের গল্প বুকমার্কে রাখতে গল্প পড়ার সময় উপরের বুকমার্ক আইকনে চাপ দিন।"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

    <!-- Bookmarks / Favorites List -->
    <ListView
        android:id="@+id/list_bookmark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="60dp"
        android:scrollbars="none" />

</LinearLayout>
